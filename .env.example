# Public site URL (OG links, emails). On Vercel, set in project settings.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — overrides default Credex link (https://www.credex.rocks/) for high-savings audit UI + lead email.
# NEXT_PUBLIC_CREDEX_CONSULT_URL=https://www.credex.rocks/

# Supabase — run SUPABASE.sql then paste project URL + service role key (server only; never expose service role to the client).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Executive readout — optional LLMs (template fallback if neither works).
# Default order: OpenAI first, then Anthropic. Override with SUMMARY_LLM_PROVIDER=openai|anthropic|auto
OPENAI_API_KEY=
# OPENAI_SUMMARY_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# SUMMARY_LLM_PROVIDER=auto

# Resend — optional; without RESEND_API_KEY, /api/leads still saves the lead but sets emailed: false.
RESEND_API_KEY=
# RESEND_FROM="Credex <onboarding@resend.dev>"
